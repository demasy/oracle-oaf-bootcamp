      "id": "case-study-001",
      "name": "Jobs & Positions Management System",
      "version": "1.4.0",
      "complexity": "Intermediate",
      "type": "Master-Detail Entity Relationship",
      "basedOn": "demasylabs-barin/brain-repo OAF Project DDL/DML scripts",
      
      "businessScenario": {
        "domain": "Human Resources - Organizational Structure",
        "description": "Manage organizational jobs and positions with master-detail relationship",
        "realWorld": "HR systems for organizational hierarchy and workforce planning"
      },
      
      "databaseSchema": {
        "note": "Schema described here for reference - NO SQL files generated",
        "masterTable": {
          "name": "XX_JOBS",
          "primaryKey": "JOB_ID (from XX_JOB_ID_SEQ)",
          "uniqueConstraint": "JOB_NAME",
          "checkConstraints": ["JOB_HEAD_COUNT > 0", "END_DATE >= START_DATE"],
          "columns": 10,
          "whoColumns": ["CREATION_DATE", "CREATED_BY", "LAST_UPDATE_DATE", "LAST_UPDATED_BY", "LAST_UPDATE_LOGIN"],
          "businessRules": [
            "Job name must be unique",
            "Head count 1-9999",
            "Start date < end date",
            "Cannot delete job with active positions"
          ]
        },
        "detailTable": {
          "name": "XX_POSITIONS",
          "primaryKey": "POSITION_ID (from XX_POSITION_ID_SEQ)",
          "foreignKey": "JOB_ID -> XX_JOBS.JOB_ID",
          "checkConstraints": ["POSITION_HEAD_COUNT > 0", "END_DATE >= START_DATE"],
          "indexes": ["JOB_ID (FK index)", "(START_DATE, END_DATE) (query performance)"],
          "columns": 11,
          "whoColumns": 5,
          "businessRules": [
            "Position must belong to valid job",
            "Position dates within job's date range",
            "Cannot delete if job requires minimum positions",
            "Head count 1-999"
          ]
        },
