  "usageGuide": {
    "messageHelperPatterns": {
      "controllerLayer": {
        "description": "User input validation and confirmation messages",
        "example": {
          "scenario": "Save button with field validation",
          "code": "public void processFormRequest(OAPageContext pageContext, OAWebBean webBean) {\n    super.processFormRequest(pageContext, webBean);\n    if (\"save\".equals(pageContext.getParameter(EVENT_PARAM))) {\n        String empName = pageContext.getParameter(\"EmpName\");\n        if (empName == null || empName.trim().isEmpty()) {\n            throw MessageHelper.createFieldRequiredError(\"Employee Name\");\n        }\n        am.invokeMethod(\"saveEmployee\", empName);\n        throw MessageHelper.createSaveSuccessMessage();\n    }\n}",
          "notes": ["Validate user input before AM calls", "Use confirmation messages after success"]
        }
      },
      "applicationModuleLayer": {
        "description": "Business rule validation",
        "example": {
          "scenario": "Business logic with FK validation",
          "code": "public void createEmployee(String name, Number deptId, Number salary) {\n    if (!isDepartmentValid(deptId)) {\n        throw MessageHelper.createRecordNotFoundError(\"Department\", deptId.toString());\n    }\n    if (salary.doubleValue() < 1000 || salary.doubleValue() > 100000) {\n        throw MessageHelper.createInvalidRangeError(\"Salary\", \"1000\", \"100000\");\n    }\n    EmployeeVOImpl vo = getEmployeeVO();\n    vo.createEmployee(name, deptId, salary);\n    getTransaction().commit();\n}",
          "notes": ["AM validates business rules", "Validate before VO operations"]
        }
      },
      "entityObjectLayer": {
        "description": "Data integrity and field constraints",
        "example": {
          "scenario": "Entity-level validation",
          "code": "protected void validateEntity() {\n    super.validateEntity();\n    String empName = (String)getEmployeeName();\n    if (empName == null || empName.trim().isEmpty()) {\n        throw MessageHelper.createError(MessageConstants.ERR_EMP_NAME_REQUIRED);\n    }\n    if (empName.length() > 200) {\n        throw MessageHelper.createInvalidLengthError(\"Employee Name\", \"200\");\n    }\n    Date startDate = (Date)getStartDate();\n    Date endDate = (Date)getEndDate();\n    if (endDate != null && endDate.before(startDate)) {\n        throw MessageHelper.createError(MessageConstants.ERR_DATE_RANGE_INVALID);\n    }\n}",
          "notes": ["EO validates data integrity", "Use validateEntity() for cross-field checks"]
        }
      }
    },
    
    "bestPractices": [
      "Always use MessageConstants, never hardcode message codes",
      "Use specific helper methods (createFieldRequiredError) instead of generic createError",
      "Provide tokens in correct order matching FND_MESSAGES definition",
      "Controller validates user input, AM validates business rules, EO validates data integrity",
      "Use confirmation messages for successful operations",
      "Catch and translate database errors to user-friendly messages"
    ],
    
    "migrationSteps": [
      "Add imports: MessageConstants, MessageHelper",
      "Identify all hardcoded error strings",
      "Find matching MessageConstants or define new ones",
      "Replace new OAException() with MessageHelper methods",
      "Add tokens in correct order",
      "Test all error scenarios"
    ]
  },
  
